---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BlogLayout title={post.data.title} description={post.data.description} date={post.data.date.toISOString()} isPost={true} url={new URL(`/blog/${post.id}/`, Astro.site).href}>
  <span class="kicker">AgenQuest Blog</span>
  <h1>{post.data.title}</h1>
  <p class="meta">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · <a href="/about/">AgenQuest research</a></p>
  <article>
    <Content />
  </article>
  <div class="byline">
    <p>Every prompt panel on this blog was run by hand, not generated. <a href="/about/">The method is written up here</a>, and we will run the same panel on your own brand free.</p>
  </div>
  <div class="cta-box">
    <h2>See what AI says about your brand.</h2>
    <p>Free audit: your category's real buyer questions, run live through ChatGPT with web search on. You get the answers, the competitors named ahead of you, and the sources behind them.</p>
    <a href="/#audit" class="btn-accent" style="text-decoration:none;">Get your free audit</a>
  </div>
</BlogLayout>
