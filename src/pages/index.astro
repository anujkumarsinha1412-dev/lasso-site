---
import Analytics from '../components/Analytics.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
<Analytics />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgenQuest — Marketing for the Age of AI | AEO, GEO &amp; Agentic Commerce for Consumer Brands</title>
<meta name="description" content="AgenQuest helps D2C and e-commerce brands get discovered, recommended, and bought by AI. Answer Engine Optimization (AEO/GEO), agentic commerce readiness, and hands-on execution — starting with a free AI visibility audit.">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#14120F">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Newsreader:opsz,wght@6..72,500;6..72,600&amp;display=swap" rel="stylesheet">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AgenQuest",
  "description": "AI-era marketing agency specializing in Answer Engine Optimization (AEO), Generative Engine Optimization (GEO), AI discovery, and agentic commerce for consumer brands.",
  "email": "audit@agenquest.com",
  "knowsAbout": ["Answer Engine Optimization", "Generative Engine Optimization", "AI Search Visibility", "Agentic Commerce", "Digital PR", "E-commerce Marketing"]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Answer Engine Optimization (AEO)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Answer Engine Optimization (AEO), also called Generative Engine Optimization (GEO), is the practice of making a brand visible and recommended inside AI-generated answers — in ChatGPT, Perplexity, Claude, Gemini, and Google AI Overviews. Where SEO optimizes for a list of links, AEO optimizes for being the answer itself: mentioned, cited, and recommended when a shopper asks an AI what to buy."
      }
    },
    {
      "@type": "Question",
      "name": "How is AgenQuest different from AI visibility monitoring tools?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Monitoring platforms show you a dashboard of where your brand stands in AI answers. AgenQuest does the work that changes the number: earning real reviews, placing citations through digital PR, engaging communities, fixing structured data and entity signals, and building AI-readable content. Tools diagnose; AgenQuest executes."
      }
    },
    {
      "@type": "Question",
      "name": "How long does AEO take to show results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Retrieval-augmented AI systems like Perplexity and search-enabled ChatGPT index new content within days, so early movement is often visible in the first 30 days. Durable, compounding gains — citations, review depth, entity authority — typically build over 90 days to 6 months. AgenQuest measures against retrieval-based engines first, because base model updates are infrequent and outside anyone's control."
      }
    },
    {
      "@type": "Question",
      "name": "What is agentic commerce?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Agentic commerce is shopping done by AI agents on a customer's behalf — researching, comparing, and increasingly completing purchases. It requires brands to be transactable by machines: clean product feeds, accurate structured data, machine-readable policies, and checkout paths agents can complete. AgenQuest prepares consumer brands for this shift."
      }
    }
  ]
}
</script>
<style is:inline>
  :root {
    --bg: #FAFAF7;
    --surface: #FFFFFF;
    --ink: #14120F;
    --ink-soft: #55524B;
    --ink-faint: #8A867D;
    --accent: #E8450A;
    --accent-soft: #FFF0E9;
    --line: #E4E1D8;
    --line-dark: #14120F;
    --good: #1A7F4E;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --sans: 'DM Sans', system-ui, sans-serif;
    --serif: 'Newsreader', Georgia, serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.6;
    font-size: 17px;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .mono { font-family: var(--mono); }

  /* ---------- Nav ---------- */
  header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(250,250,247,0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  nav { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 22px; letter-spacing: -0.5px; text-decoration: none; color: var(--ink); }
  .logo-mark {
    width: 30px; height: 30px; border-radius: 50%;
    border: 2.5px solid var(--ink); position: relative; flex-shrink: 0;
  }
  .logo-mark::after {
    content: ''; position: absolute; width: 12px; height: 12px;
    border-radius: 50%; background: var(--accent);
    bottom: -4px; right: -4px; border: 2.5px solid var(--bg);
  }
  .nav-links { display: flex; gap: 28px; align-items: center; }
  .nav-links a { text-decoration: none; color: var(--ink-soft); font-size: 15px; font-weight: 500; }
  .nav-links a:hover { color: var(--ink); }
  .nav-cta-short { display:none; }
  .btn {
    display: inline-block; text-decoration: none; font-weight: 600;
    padding: 12px 22px; border-radius: 3px; font-size: 15px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
    cursor: pointer; border: none; font-family: var(--sans);
  }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary { background: var(--ink); color: #fff; }
  .btn-primary:hover { box-shadow: 0 4px 14px rgba(20,18,15,0.25); }
  .btn-accent { background: var(--accent); color: #fff; }
  .btn-accent:hover { box-shadow: 0 4px 14px rgba(232,69,10,0.35); }
  .btn-ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--line-dark); }
  .btn-lg { padding: 15px 28px; font-size: 16px; }

  /* ---------- Section scaffolding ---------- */
  section { padding: 88px 0; border-bottom: 1px solid var(--line); }
  .kicker {
    font-family: var(--mono); font-size: 12.5px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent); font-weight: 500;
    display: block; margin-bottom: 16px;
  }
  h1 { font-family: var(--serif); font-size: clamp(46px, 6.8vw, 78px); line-height: .94; letter-spacing: -0.035em; font-weight: 600; }
  h2 { font-family: var(--serif); font-size: clamp(34px, 4.2vw, 50px); line-height: 1.02; letter-spacing: -0.025em; font-weight: 600; margin-bottom: 18px; }
  h3 { font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
  .lede { font-size: 19px; color: var(--ink-soft); max-width: 640px; }

  /* ---------- Hero ---------- */
  .hero { padding: 92px 0 78px; border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 72px; align-items: center; }
  .hero h1 .hl { color: var(--accent); }
  .hero .lede { margin: 22px 0 30px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .hero-note { font-family: var(--mono); font-size: 12.5px; color: var(--ink-faint); margin-top: 14px; }

  /* Chat mock */
  .chat-card {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 3px; box-shadow: 18px 18px 0 #EDE9DF;
    overflow: hidden; font-size: 14.5px;
  }
  .chat-head {
    display: flex; align-items: center; gap: 8px; padding: 12px 16px;
    border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 12px; color: var(--ink-faint);
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .dot.active { background: var(--good); }
  .chat-body { padding: 20px; }
  .chat-q {
    background: var(--bg); border: 1px solid var(--line); border-radius: 10px 10px 10px 2px;
    padding: 12px 14px; font-weight: 500; margin-bottom: 16px; max-width: 88%;
  }
  .chat-a { color: var(--ink-soft); }
  .chat-a p { margin-bottom: 12px; }
  .rec {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; margin-bottom: 8px;
    background: var(--surface); color: var(--ink-soft);
  }
  .rec.win {
    border: 1.5px solid var(--accent); background: var(--accent-soft); color: var(--ink);
    font-weight: 600;
  }
  .rec .tag { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); }
  .rec.win .tag { color: var(--accent); font-weight: 500; }
  .cite-row { display: flex; gap: 6px; margin-top: 14px; flex-wrap: wrap; }
  .cite {
    font-family: var(--mono); font-size: 10.5px; padding: 4px 9px;
    border: 1px solid var(--line); border-radius: 99px; color: var(--ink-faint);
  }

  /* ---------- Proof note ---------- */
  .proof-note { padding: 0; background: var(--ink); color: #fff; }
  .proof-grid { display: grid; grid-template-columns: .72fr 1.28fr; }
  .proof-intro { padding: 46px 46px 46px 0; border-right: 1px solid rgba(255,255,255,.18); }
  .proof-intro .kicker { margin-bottom: 12px; }
  .proof-intro h2 { font-size: clamp(31px,3.4vw,42px); color: #fff; }
  .proof-intro p { color: rgba(255,255,255,.66); max-width: 390px; }
  .proof-pages { display: grid; grid-template-columns: repeat(3,1fr); }
  .proof-page { padding: 46px 28px; border-right: 1px solid rgba(255,255,255,.12); }
  .proof-page:last-child { border-right: 0; }
  .proof-page .folio { font-family: var(--mono); color: var(--accent); font-size: 11px; letter-spacing: .12em; }
  .proof-page h3 { margin: 28px 0 8px; color: #fff; }
  .proof-page p { color: rgba(255,255,255,.6); font-size: 14px; line-height: 1.55; }

  /* ---------- Working note ---------- */
  .working-note { display:grid; grid-template-columns: .7fr 1.3fr; gap: 72px; margin-top: 44px; border-top: 1.5px solid var(--line-dark); padding-top: 30px; }
  .working-note .aside { font-family:var(--mono); font-size:12px; color:var(--ink-faint); line-height:1.7; }
  .principles { display:grid; grid-template-columns:1fr 1fr; gap: 26px 40px; }
  .principle { border-top:1px solid var(--line); padding-top:14px; }
  .principle strong { display:block; margin-bottom:5px; }
  .principle p { color:var(--ink-soft); font-size:14.5px; }

  /* ---------- Shift cards ---------- */
  .card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 44px; }
  .card { border-top: 1.5px solid var(--line-dark); padding: 24px 18px 0 0; }
  .card .idx { font-family: var(--mono); font-size: 12px; color: var(--accent); display: block; margin-bottom: 36px; }
  .card h3 { margin-bottom: 10px; }
  .card p { color: var(--ink-soft); font-size: 15.5px; }

  /* ---------- Services ---------- */
  .svc-list { margin-top: 44px; border-top: 1px solid var(--line-dark); }
  .svc {
    display: grid; grid-template-columns: 72px 1fr 1.3fr; gap: 28px;
    padding: 34px 0; border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .svc .n { font-family: var(--mono); font-size: 14px; color: var(--ink-faint); padding-top: 4px; }
  .svc h3 { font-size: 22px; }
  .svc .sub { font-family: var(--mono); font-size: 12px; color: var(--accent); margin-top: 6px; letter-spacing: 0.06em; text-transform: uppercase; }
  .svc p { color: var(--ink-soft); font-size: 16px; }

  /* ---------- Signals table ---------- */
  .signals { background: var(--surface); }
  .sig-table { width: 100%; border-collapse: collapse; margin-top: 40px; font-size: 15.5px; }
  .sig-table th {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
    text-align: left; color: var(--ink-faint); font-weight: 500;
    padding: 0 16px 14px 0; border-bottom: 1.5px solid var(--line-dark);
  }
  .sig-table td { padding: 20px 16px 20px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .sig-table td:first-child { font-weight: 600; white-space: nowrap; }
  .sig-table td:nth-child(2) { color: var(--ink-soft); }
  .sig-table .why { font-family: var(--mono); font-size: 12.5px; color: var(--ink-faint); }

  /* ---------- Wedge ---------- */
  .wedge-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 44px; }
  .wedge-col { border-radius: 12px; padding: 32px 30px; }
  .wedge-col.them { background: var(--surface); border: 1px dashed var(--line-dark); }
  .wedge-col.us { background: var(--ink); color: #fff; }
  .wedge-col .tag { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; display: block; margin-bottom: 18px; }
  .wedge-col.them .tag { color: var(--ink-faint); }
  .wedge-col.us .tag { color: var(--accent); }
  .wedge-col ul { list-style: none; }
  .wedge-col li { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 16px; }
  .wedge-col.us li { border-bottom: 1px solid rgba(255,255,255,0.14); }
  .wedge-col li:last-child { border-bottom: none; }
  .wedge-col li::before { content: '→ '; font-family: var(--mono); color: var(--ink-faint); }
  .wedge-col.us li::before { color: var(--accent); }

  /* ---------- Evidence ---------- */
  .ev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 44px; }
  .ev { border-top: 1.5px solid var(--line-dark); padding: 24px 18px 0 0; }
  .ev .fig { font-size: 34px; font-weight: 700; letter-spacing: -0.02em; }
  .ev p { color: var(--ink-soft); font-size: 15px; margin-top: 8px; }
  .ev .src { font-family: var(--mono); font-size: 11.5px; color: var(--ink-faint); margin-top: 12px; }

  /* ---------- Process ---------- */
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 48px; border-top: 1.5px solid var(--line-dark); }
  .step { padding: 28px 22px 0 0; position: relative; }
  .step::before {
    content: ''; position: absolute; top: -6px; left: 0;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--bg); border: 2.5px solid var(--ink);
  }
  .step:first-child::before { background: var(--accent); border-color: var(--accent); }
  .step .when { font-family: var(--mono); font-size: 12px; color: var(--accent); letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 10px; }
  .step h3 { margin-bottom: 8px; font-size: 17.5px; }
  .step p { color: var(--ink-soft); font-size: 14.5px; }

  /* ---------- FAQ ---------- */
  .faq details {
    border-bottom: 1px solid var(--line); padding: 4px 0;
  }
  .faq details:first-of-type { border-top: 1.5px solid var(--line-dark); margin-top: 40px; }
  .faq summary {
    cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;
    font-weight: 600; font-size: 18px; padding: 22px 0;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; font-family: var(--mono); font-size: 22px; color: var(--accent); transition: transform 0.2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq .a { color: var(--ink-soft); padding: 0 0 24px; max-width: 780px; font-size: 16px; }
  .faq .a p { margin-bottom: 12px; }
  .faq .a p:last-child { margin-bottom: 0; }

  /* ---------- Contact ---------- */
  .contact { background: var(--ink); color: #fff; border-bottom: none; }
  .contact .kicker { color: var(--accent); }
  .contact h2 { color: #fff; }
  .contact .lede { color: rgba(255,255,255,0.65); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .form-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.14); border-radius: 14px; padding: 32px; }
  .form-card label { font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.6); display: block; margin: 18px 0 8px; }
  .form-card label:first-of-type { margin-top: 0; }
  .form-card input, .form-card select {
    width: 100%; padding: 13px 14px; border-radius: 7px;
    border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.07);
    color: #fff; font-family: var(--sans); font-size: 15.5px;
  }
  .form-card input::placeholder { color: rgba(255,255,255,0.35); }
  .form-card select option { color: var(--ink); }
  .form-card .btn { width: 100%; margin-top: 26px; text-align: center; }
  .form-note { font-family: var(--mono); font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 14px; text-align: center; }
  .deliver { list-style: none; margin-top: 28px; }
  .deliver li { padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,0.12); font-size: 16px; color: rgba(255,255,255,0.85); }
  .deliver li::before { content: '✓  '; color: var(--accent); font-weight: 700; }

  /* ---------- Footer ---------- */
  footer { background: var(--ink); color: rgba(255,255,255,0.5); padding: 36px 0 44px; border-top: 1px solid rgba(255,255,255,0.12); }
  .foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; font-size: 14px; }
  .foot .logo { color: #fff; font-size: 18px; }
  .foot .logo-mark { border-color: #fff; width: 24px; height: 24px; }
  .foot .logo-mark::after { border-color: var(--ink); width: 10px; height: 10px; }
  .foot-tag { font-family: var(--mono); font-size: 12px; }
  .foot-links { display:flex; gap:18px; }
  .foot-links a { color:rgba(255,255,255,.62); text-decoration:none; }
  .foot-links a:hover { color:#fff; }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .hero-grid, .contact-grid, .wedge-grid, .working-note { grid-template-columns: 1fr; }
    .proof-grid { grid-template-columns:1fr; }
    .proof-intro { padding:42px 0; border-right:0; border-bottom:1px solid rgba(255,255,255,.18); }
    .proof-pages { grid-template-columns:repeat(3,1fr); }
    .stat-grid, .card-grid, .ev-grid { grid-template-columns: 1fr; gap: 18px; }
    .steps { grid-template-columns: 1fr 1fr; row-gap: 32px; }
    .svc { grid-template-columns: 1fr; gap: 10px; }
    .svc .n { padding-top: 0; }
    .nav-links a:not(.btn) { display: none; }
    section { padding: 64px 0; }
    .working-note { gap:28px; }
  }

  @media (max-width: 640px) {
    .wrap { padding:0 18px; }
    nav { height:60px; }
    .logo { font-size:19px; }
    .logo-mark { width:26px; height:26px; }
    .nav-links .btn { padding:10px 13px; font-size:13px; }
    .nav-cta-long { display:none; }
    .nav-cta-short { display:inline; }
    .hero { padding:58px 0 54px; }
    .hero-grid { gap:42px; }
    .hero .lede { font-size:17px; margin:18px 0 24px; }
    .hero-ctas { align-items:flex-start; flex-direction:column; }
    .hero-ctas .btn { width:100%; text-align:center; }
    .hero-ctas .btn-ghost { border:0; padding:7px 0; text-align:left; width:auto; }
    .chat-card { box-shadow:10px 10px 0 #EDE9DF; }
    .proof-pages { grid-template-columns:1fr; }
    .proof-page { padding:28px 0; border-right:0; border-bottom:1px solid rgba(255,255,255,.12); }
    .proof-page h3 { margin:12px 0 5px; }
    .principles { grid-template-columns:1fr; }
    .steps { grid-template-columns:1fr; }
    .sig-table, .sig-table tbody, .sig-table tr, .sig-table td { display:block; width:100%; }
    .sig-table thead { display:none; }
    .sig-table tr { padding:22px 0; border-bottom:1px solid var(--line); }
    .sig-table td { border:0; padding:4px 0; white-space:normal!important; }
    .sig-table td:first-child { font-size:17px; }
    .sig-table .why { margin-top:7px; color:var(--ink-faint); }
  }

  /* ---------- Audit wizard ---------- */
  .wstep[hidden]{display:none;}
  .wtitle{font-weight:600;font-size:19px;letter-spacing:-0.02em;margin-bottom:5px;color:#fff;}
  .w-sub{font-size:14px;color:rgba(255,255,255,0.45);margin-bottom:20px;}
  /* ---------- question list (scoped inside .form-card to beat label styling) ---------- */
  .form-card .w-q{
    display:flex;gap:13px;align-items:flex-start;margin:0;padding:13px 2px;
    font-family:var(--sans);font-size:15px;line-height:1.55;font-weight:400;
    text-transform:none;letter-spacing:-0.005em;color:rgba(255,255,255,0.82);
    cursor:pointer;border:0;border-radius:8px;transition:color .15s ease,background .15s ease;
  }
  .form-card .w-q:hover{color:#fff;background:rgba(255,255,255,0.035);}
  .form-card .w-q + .w-q{border-top:1px solid rgba(255,255,255,0.07);}
  /* custom checkbox */
  .form-card .w-q input[type=checkbox]{
    appearance:none;-webkit-appearance:none;
    width:17px;height:17px;min-width:17px;margin:3px 0 0;padding:0;flex:0 0 auto;
    border:1.5px solid rgba(255,255,255,0.28);border-radius:5px;background:transparent;
    cursor:pointer;position:relative;transition:all .15s ease;
  }
  .form-card .w-q:hover input[type=checkbox]{border-color:rgba(255,255,255,0.5);}
  .form-card .w-q input[type=checkbox]:checked{background:var(--accent);border-color:var(--accent);}
  .form-card .w-q input[type=checkbox]:checked::after{
    content:'';position:absolute;left:5px;top:1.5px;width:4px;height:9px;
    border:solid #fff;border-width:0 2px 2px 0;transform:rotate(43deg);
  }
  .form-card .w-q input[type=checkbox]:not(:checked) ~ span{color:rgba(255,255,255,0.32);}
  /* meta lines */
