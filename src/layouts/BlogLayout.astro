---
import SiteLayout from './SiteLayout.astro';
const { title, description, date, isPost=false, url }=Astro.props;
const article=isPost?{'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:date,dateModified:date,author:{'@type':'Organization','@id':'https://agenquest.com/#organization',name:'Agenquest Research',url:'https://agenquest.com/about/'},publisher:{'@type':'Organization','@id':'https://agenquest.com/#organization',name:'Agenquest',url:'https://agenquest.com/',logo:{'@type':'ImageObject',url:'https://agenquest.com/icon-512.png'}},mainEntityOfPage:url}:null;
---
<SiteLayout title={`${title} | Agenquest`} description={description} article={article} wide={false}><div class="reading-wrap"><slot/></div></SiteLayout>
