{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "agenquest-mail-retry",
  "main": "index.js",
  "account_id": "bbd31cdf134a96ef6b704a61fb57cbbb",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    { "binding": "RETRY_STATUS", "id": "04d302dca5ec47a48a6ff79b783648f7" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
