<!-- ================= FAQ ================= -->
<section class="faq" id="faq">
  <div class="wrap">
    <span class="kicker">08 / FAQ</span>
    <h2>Straight answers.</h2>

    <details open>
      <summary>What is Answer Engine Optimization (AEO)?</summary>
      <div class="a">
        <p>Answer Engine Optimization — also called Generative Engine Optimization (GEO) — is the practice of making your brand visible and recommended inside AI-generated answers on ChatGPT, Perplexity, Claude, Gemini, and Google AI Overviews. Where SEO optimizes for a list of links, AEO optimizes for being the answer itself: named, cited, and recommended when a shopper asks an AI what to buy.</p>
      </div>
    </details>
    <details>
      <summary>How is this different from SEO? Do I still need SEO?</summary>
      <div class="a">
        <p>They overlap but aren't the same. SEO earns rankings on a results page; AEO earns mentions and citations inside a synthesized answer, drawing on sources SEO mostly ignores — reviews, Reddit threads, press citations, YouTube transcripts, entity data. Good SEO fundamentals still help (AI engines crawl the same web), but they're no longer sufficient. Most of our clients keep their SEO efforts and add AEO on top.</p>
      </div>
    </details>
    <details>
      <summary>How long until we see results?</summary>
      <div class="a">
        <p>Honestly: it depends on the engine. Retrieval-based systems (Perplexity, search-enabled ChatGPT, AI Overviews) index new content within days, so early movement typically shows inside the first 30 days. Durable gains — citation authority, review depth, community trust — compound over 90 days to 6 months. Anyone promising to "rank you #1 in ChatGPT" in two weeks is selling you something that doesn't exist.</p>
      </div>
    </details>
    <details>
      <summary>How do you measure success?</summary>
      <div class="a">
        <p>Brand mention rate and answer position across a fixed panel of real consumer prompts, citation share (how often your content is the source behind an answer), and sentiment — benchmarked against named competitors, tracked monthly, and tied to the specific work shipped. We measure retrieval-based engines first because they respond to new signals in days; base-model updates are infrequent and outside anyone's control, so we don't sell them as a KPI.</p>
      </div>
    </details>
    <details>
      <summary>Is any of this against platform rules? Do you buy reviews or run fake accounts?</summary>
      <div class="a">
        <p>No. Fake and AI-generated reviews are explicitly illegal under the FTC's Consumer Review Rule, and astroturfed community posts get brands banned and blacklisted. Everything AgenQuest does is white-hat: accelerating <em>real</em> review acquisition, earning <em>real</em> press citations, disclosed community participation, and technical work on your own properties. The durable advantage comes from legitimate signals — which is exactly why they're worth building.</p>
      </div>
    </details>
    <details>
      <summary>What does an engagement cost?</summary>
      <div class="a">
        <p>The audit is free — genuinely, with no obligation. Ongoing engagements are monthly retainers scoped to the levers your audit says will move the needle, with cost and expected return stated before you commit. We'd rather show you findings first and let the work make the case.</p>
      </div>
    </details>
    <details>
      <summary>What is agentic commerce, and why should I care now?</summary>
      <div class="a">
        <p>Agentic commerce is shopping done by AI agents on a customer's behalf — researching, comparing, and increasingly completing purchases end to end. It demands that your store be transactable by machines: clean product feeds, accurate structured data, machine-readable policies, and checkout paths an agent can complete. Adoption is early but moving fast, and the brands that are agent-ready first inherit the same advantage early SEO adopters had. Discovery work (AEO) and transactability work compound — we build both.</p>
      </div>
    </details>
  </div>
</section>

<footer>
  <div class="wrap foot">
    <a class="logo" href="#top"><span class="logo-mark"></span>AgenQuest</a>
    <span class="foot-tag">// marketing for the age of AI — AEO · GEO · agentic commerce</span>
    <span class="foot-links"><a href="/blog/">Notes</a><a href="/privacy/">Privacy</a><a href="mailto:hello@agenquest.com">hello@agenquest.com</a></span>
    <span>© 2026 AgenQuest.</span>
  </div>
</footer>

<script is:inline>
(function(){
  const $ = (id) => document.getElementById(id);
  const show = (n) => { for (const i of [1,2,3,4]) $('ws'+i).hidden = i!==n; };
  const track = (name, params) => { try { if (window.gtag) window.gtag('event', name, params || {}); } catch(e){} };
  const escq = (s) => String(s).replace(/[<>&]/g, (c)=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
  let state = { brand:'', site:'', cat:'', queries:[], report:null };

  $('w-gen').addEventListener('click', async () => {
    const brand = $('w-brand').value.trim();
    if (!brand) { $('w-brand').focus(); return; }
    const looksUrl = /\.[a-z]{2,}/i.test(brand);
    state.brand = brand; state.site = looksUrl ? brand : ''; state.cat = '';
    track('audit_started', {brand: state.brand});
    $('w-gen').disabled = true; $('w-gen').textContent = 'Researching your brand…';
    try {
      const r = await fetch('/api/suggest', {method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({brand: state.brand, website: state.site})});
      const d = await r.json();
      if (!r.ok || !d.queries || !d.queries.length) throw new Error(d.error || 'no questions returned');
      state.queries = d.queries; state.meta = d;
      track('audit_prompts_generated', {brand: state.brand, category: d.category || '', question_count: d.queries.length});
      renderList(); show(2);
    } catch(e){ alert('Could not generate questions — please check the name and try again.'); }
    $('w-gen').disabled = false; $('w-gen').textContent = 'Research my brand & build prompts';
  });

  function renderList(){
    const m = state.meta || {};
    const bits = [];
    if (m.research && m.research.site) bits.push('read your site');
    if (m.research && m.research.searched) bits.push('searched the web');
    const head = m.category ? '<p class="w-found"><b>'+escq(m.category)+'</b>'
      + (bits.length ? ' · ' + bits.join(', ') : '') + '</p>' : '';
    $('w-list').innerHTML = head + state.queries.map((q,i)=>'<label class="w-q"><input type="checkbox" checked data-i="'+i+'"> <span>'+escq(q)+'</span></label>').join('')
      + '<p class="w-count">'+state.queries.length+' questions ready</p>';
  }

  $('w-custom').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); $('w-addbtn').click(); } });
  $('w-addbtn').addEventListener('click', () => {
    const v = $('w-custom').value.trim();
    if (!v) return;
    state.queries.push(v); $('w-custom').value=''; renderList();
    track('audit_question_added', {brand: state.brand});
  });

  const STATUSES = ['Asking ChatGPT your questions…','Reading the answers…','Checking which brands get named…','Scoring your visibility…','Almost there…'];
  $('w-run').addEventListener('click', async () => {
    const selected = Array.from(document.querySelectorAll('#w-list input:checked')).map((el)=>state.queries[+el.dataset.i]);
    if (!selected.length) { alert('Keep at least one question.'); return; }
    track('audit_run', {brand: state.brand, question_count: selected.length});
    show(3);
    let si=0; const t = setInterval(()=>{ si=(si+1)%STATUSES.length; $('w-status').textContent=STATUSES[si]; }, 6000);
    try {
      const r = await fetch('/api/audit', {method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({brand: state.brand, website: state.site, queries: selected})});
      const d = await r.json();
      clearInterval(t);
      if (d.error) throw new Error(d.error);
      state.report = d; renderReport(d); show(4);
      track('audit_completed', {brand: state.brand, score: (d.overall && d.overall.score) || 0});
    } catch(e){ clearInterval(t); alert('The audit hit a snag — please try again in a minute.'); show(2); }
  });

  function renderReport(d){
    const rows = (d.results||[]).map((r)=>'<div class="w-row"><div class="w-rq">'+escq(r.query)+'</div><div><span class="w-badge w-'+escq(r.prominence)+'">'+escq(r.prominence)+'</span></div><div class="w-rn">'+escq(r.note||'')+'</div></div>').join('');
    const gaps = ((d.overall&&d.overall.gaps)||[]).map((g)=>'<li>'+escq(g)+'</li>').join('');
    $('w-report').innerHTML = '<div class="w-score"><span>'+((d.overall&&d.overall.score)!=null?d.overall.score:'?')+'</span>/100</div>'
      + '<p class="w-sum">'+escq((d.overall&&d.overall.summary)||'')+'</p>' + rows
      + '<p class="w-gapt">Top gaps holding you back:</p><ul class="w-gaps">'+gaps+'</ul>';
  }

  $('w-unlock').addEventListener('click', async () => {
    const email = $('w-email').value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { $('w-email').focus(); return; }
    $('w-unlock').disabled = true; $('w-unlock').textContent = 'Unlocking…';
    try {
      await fetch('/api/lead', {method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({email: email, phone: $('w-phone').value.trim(), brand: state.brand, website: state.site, report: state.report})});
    } catch(e){}
    track('generate_lead', {brand: state.brand, score: (state.report && state.report.overall && state.report.overall.score) || 0,
      ai_source: (function(){ try { return sessionStorage.getItem('aq_ai_source') || 'none'; } catch(e){ return 'none'; } })()});
    $('w-report').classList.remove('w-blur');
    $('w-gate').innerHTML = '<p class="wtitle">✓ Report unlocked — a copy is on its way to your inbox.</p><p class="form-note">// We will follow up with what it takes to close the gaps.</p>';
  });
})();
</script>

</body>
</html>
