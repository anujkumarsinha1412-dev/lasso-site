---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
const posts=(await getCollection('blog')).filter(p=>!p.data.draft).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const category=(id)=>id.startsWith('improving-')?'Brand teardowns':['how-ai-engines-choose-brands','ai-visibility-metrics','webflow-vs-framer-ai-recommendations','ramp-vs-brex-ai-recommendations'].includes(id)?'Research notes':'Practical guides';
const featured=posts.filter(p=>p.id.startsWith('improving-'));
---
<SiteLayout title="AEO Research and Brand Teardowns | Agenquest" description="Independent brand analyses, practical AEO guides, and research on AI discovery, with observations, sources, and clear limits.">
<div class="container page-intro"><p class="eyebrow">Research & insights</p><h1>Research on AI discovery,<br/>with the work shown.</h1><p class="lede">Brand teardowns, practical guides, and notes on what we're learning about AEO. We separate what we observed from what we think a business should test next.</p>
<section class="section"><h2>What we would do if hired</h2><p>Independent analyses of real brands, with observations and proposed actions. These are research examples, not client results.</p><div class="research-grid">{featured.map(p=><a class="research-card" href={`/blog/${p.id}/`}><span class="eyebrow">Independent brand teardown</span><h3>{p.data.title}</h3><p>{p.data.description}</p><span class="text-link">Read the analysis →</span></a>)}</div></section>
<section class="section archive"><h2>All research</h2><div class="filter-bar" role="group" aria-label="Filter research" hidden>{['All','Brand teardowns','Practical guides','Research notes'].map((label,i)=><button type="button" data-category={label} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div><p id="filter-status" class="sr-only" aria-live="polite"></p><div class="archive-grid">{posts.map(post=><a class="post-card" href={`/blog/${post.id}/`} data-post-category={category(post.id)}><span class="eyebrow">{category(post.id)}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="post-date"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB',{year:'numeric',month:'long',day:'numeric'})}</time> · Agenquest Research</span></a>)}</div></section></div>
</SiteLayout>
<script>
const bar=document.querySelector('.filter-bar');bar?.removeAttribute('hidden');bar?.addEventListener('click',event=>{const button=event.target instanceof Element?event.target.closest('button'):null;if(!button)return;const category=button.dataset.category;for(const b of bar.querySelectorAll('button'))b.setAttribute('aria-pressed',String(b===button));let count=0;for(const card of document.querySelectorAll('[data-post-category]')){const show=category==='All'||card.getAttribute('data-post-category')===category;card.toggleAttribute('hidden',!show);if(show)count++;}document.querySelector('#filter-status').textContent=`Showing ${count} articles`;});
</script>
